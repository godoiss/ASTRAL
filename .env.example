# ASTRAL FastAPI deployment profile
ASTRAL_DEPLOYMENT_MODE=public_read_only
ASTRAL_API_CORS_ORIGINS=http://127.0.0.1:3000
ASTRAL_API_ALLOWED_HOSTS=localhost,127.0.0.1
ASTRAL_FRONTEND_URL=http://127.0.0.1:3000
ASTRAL_DISCOVERY_EXECUTION_ENABLED=false
ASTRAL_DISCOVERY_DOWNLOADS_ENABLED=false
ASTRAL_CANDIDATE_REVIEWS_ENABLED=false
ASTRAL_RATE_LIMIT_PER_MINUTE=60

