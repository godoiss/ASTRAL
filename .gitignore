# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
web/node_modules/
web/.next/
web/out/
web/coverage/
web/.vitest-data/
web/next-env.d.ts
.mypy_cache/
.ruff_cache/
.cache/
logs/
.codex/

# Virtual environments
.venv/
venv/
env/

# Coverage and build artifacts
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local configuration and secrets
.env
.env.*
!.env.example

# Astronomical datasets and generated model artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Deep Space Observatory downloads and derived local signal artifacts
data/observatory/cache/*
data/observatory/raw/*
data/observatory/processed/*
data/observatory/neural/*
data/observatory/provenance/*
data/observatory/catalog/*
!data/observatory/cache/.gitkeep
!data/observatory/raw/.gitkeep
!data/observatory/processed/.gitkeep
!data/observatory/neural/.gitkeep
!data/observatory/provenance/.gitkeep
!data/observatory/catalog/.gitkeep

# ANN-02 incremental signals, checkpoints, and trained artifacts
data/ann02/*
!data/ann02/.gitkeep

# Isolated Stage 07 TESS pilot products (never mixed with Kepler training)
data/tess_experimental/

# Stage 10 bounded discovery cache (real downloaded cadences stay local)
data/discovery/raw/*
data/discovery/provenance/*
!data/discovery/raw/.gitkeep
!data/discovery/provenance/.gitkeep

# Stage 12 operational research metadata (local SQLite state and journals)
data/research/*
!data/research/.gitkeep
